<?xml version="1.0" encoding="utf-8"?>
<!-- YASKAWA GP7 6-DoF Industrial Robot Arm + Parallel-Jaw Gripper (SolidWorks CAD Model)
     Configured for ROS 2 Jazzy & Gazebo Harmonic (gz-sim8) -->
<robot name="Assem1">

  <!-- World anchor so base_link is fixed at origin (0, 0, 0) -->
  <link name="world"/>
  <joint name="world_to_base_link" type="fixed">
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <parent link="world"/>
    <child link="base_link"/>
  </joint>

  <link name="base_link">
    <inertial>
      <origin xyz="0.00556892272739621 -6.27065509379752E-07 0.0947579647168589" rpy="0 0 0" />
      <mass value="5.21544079925593" />
      <inertia
        ixx="0.0260256781512776"
        ixy="-2.59247459054418E-05"
        ixz="-0.000139844593802777"
        iyy="0.0252950776511291"
        iyz="4.76784711524198E-05"
        izz="0.0217205299171922" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://Assem1/meshes/base_link.STL" />
      </geometry>
      <material name="yaskawa_dark">
        <color rgba="0.18 0.20 0.24 1" />
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://Assem1/meshes/base_link.STL" />
      </geometry>
    </collision>
  </link>

  <link name="link1">
    <inertial>
      <origin xyz="-0.0156718305527117 0.000134503632574314 0.0909494435463641" rpy="0 0 0" />
      <mass value="2.94469826367007" />
      <inertia
        ixx="0.0111813529969643"
        ixy="1.70296562644481E-06"
        ixz="0.00217925627367546"
        iyy="0.0119470130323578"
        iyz="-1.22527679828146E-06"
        izz="0.00886869029563989" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://Assem1/meshes/link1.STL" />
      </geometry>
      <material name="yaskawa_blue">
        <color rgba="0.05 0.35 0.78 1" />
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://Assem1/meshes/link1.STL" />
      </geometry>
    </collision>
  </link>

  <joint name="link0_to_link1_joint" type="revolute">
    <origin xyz="0 0 0.199000000000508" rpy="0 0 0" />
    <parent link="base_link" />
    <child link="link1" />
    <axis xyz="0 0 1" />
    <limit lower="-6.28318" upper="6.28318" effort="200" velocity="6.5" />
  </joint>

  <link name="link2">
    <inertial>
      <origin xyz="-0.0276252107318509 0.194988827430017 -0.000201924064720581" rpy="0 0 0" />
      <mass value="6.24055076634278" />
      <inertia
        ixx="0.126298777880261"
        ixy="-0.000192553439098959"
        ixz="4.29067873327294E-05"
        iyy="0.0277565781571922"
        iyz="0.000482848124259666"
        izz="0.110519548003228" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://Assem1/meshes/link2.STL" />
      </geometry>
      <material name="yaskawa_blue">
        <color rgba="0.05 0.35 0.78 1" />
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://Assem1/meshes/link2.STL" />
      </geometry>
    </collision>
  </link>

  <joint name="link1_to_link2_joint" type="revolute">
    <origin xyz="-0.0400000001871289 0 0.130999999999492" rpy="1.5707963267949 0 3.14159265358979" />
    <parent link="link1" />
    <child link="link2" />
    <axis xyz="0 0 -1" />
    <limit lower="-3.14159" upper="3.14159" effort="200" velocity="5.5" />
  </joint>

  <link name="link3">
    <inertial>
      <origin xyz="0.0200549894962703 0.0159086609244596 0.000853911286062742" rpy="0 0 0" />
      <mass value="2.84915106703938" />
      <inertia
        ixx="0.00693418510095249"
        ixy="0.000903674003992465"
        ixz="3.86443382149677E-05"
        iyy="0.00823186102679539"
        iyz="2.89656264033356E-05"
        izz="0.00779150668168677" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://Assem1/meshes/link3.STL" />
      </geometry>
      <material name="yaskawa_white">
        <color rgba="0.88 0.90 0.92 1" />
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://Assem1/meshes/link3.STL" />
      </geometry>
    </collision>
  </link>

  <joint name="link2_to_link3_joint" type="revolute">
    <origin xyz="0 0.445000000000108 0" rpy="0 0 1.5707963267949" />
    <parent link="link2" />
    <child link="link3" />
    <axis xyz="0 0 -1" />
    <limit lower="-3.14159" upper="3.14159" effort="200" velocity="7.0" />
  </joint>

  <link name="link4">
    <inertial>
      <origin xyz="0.000150050822269487 0.000159742589693235 0.247766889303955" rpy="0 0 0" />
      <mass value="2.75543484796911" />
      <inertia
        ixx="0.0100849954230413"
        ixy="-1.17989427737781E-05"
        ixz="-8.23566325356412E-06"
        iyy="0.010784911689807"
        iyz="0.000318529263421957"
        izz="0.00308571663122744" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://Assem1/meshes/link4.STL" />
      </geometry>
      <material name="yaskawa_blue">
        <color rgba="0.05 0.35 0.78 1" />
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://Assem1/meshes/link4.STL" />
      </geometry>
    </collision>
  </link>

  <joint name="link3_to_link4_joint" type="revolute">
    <origin xyz="0.0399999999343005 0 0" rpy="1.5707963267949 0 0" />
    <parent link="link3" />
    <child link="link4" />
    <axis xyz="0 0 1" />
    <limit lower="-3.14159" upper="3.14159" effort="150" velocity="9.5" />
  </joint>

  <link name="llink5">
    <inertial>
      <origin xyz="-0.000230394399826195 -0.0132104934834168 -0.00175270168212115" rpy="0 0 0" />
      <mass value="0.245886292476196" />
      <inertia
        ixx="0.000139547969180005"
        ixy="-2.13471190815251E-06"
        ixz="-8.08863754810169E-07"
        iyy="0.000156835349412098"
        iyz="1.26386980425683E-06"
        izz="0.000185603510077084" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://Assem1/meshes/llink5.STL" />
      </geometry>
      <material name="yaskawa_white">
        <color rgba="0.88 0.90 0.92 1" />
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://Assem1/meshes/llink5.STL" />
      </geometry>
    </collision>
  </link>

  <joint name="link4_to_llink5_joint" type="revolute">
    <origin xyz="0 0 0.442000000019422" rpy="-1.5707963267949 0 0" />
    <parent link="link4" />
    <child link="llink5" />
    <axis xyz="0 0 -1" />
    <limit lower="-3.14159" upper="3.14159" effort="150" velocity="9.5" />
  </joint>

  <link name="link6">
    <inertial>
      <origin xyz="-2.87940494668737E-05 -1.00540120492793E-06 0.081357340227961" rpy="0 0 0" />
      <mass value="0.0556915724295805" />
      <inertia
        ixx="2.71257107858577E-05"
        ixy="-4.28639235525098E-16"
        ixz="-5.59217655473938E-09"
        iyy="1.87014120858917E-05"
        iyz="-8.0355204569625E-16"
        izz="4.31058718516138E-05" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://Assem1/meshes/link6.STL" />
      </geometry>
      <material name="yaskawa_dark">
        <color rgba="0.22 0.24 0.28 1" />
      </material>
    </visual>
  </link>

  <joint name="link5_to_link6_joint" type="revolute">
    <origin xyz="0 0 0" rpy="1.5707963267949 0 0" />
    <parent link="llink5" />
    <child link="link6" />
    <axis xyz="0 0 -1" />
    <limit lower="-6.28318" upper="6.28318" effort="100" velocity="15.0" />
  </joint>

  <!-- Tool Center Point (TCP) frame between the parallel gripper jaws -->
  <link name="tcp_link"/>
  <joint name="link6_to_tcp_joint" type="fixed">
    <origin xyz="0 0 0.1125" rpy="0 0 0" />
    <parent link="link6" />
    <child link="tcp_link" />
  </joint>

  <link name="link7">
    <inertial>
      <origin xyz="2.00117700188684E-12 -0.0222727272729961 0.039999999998471" rpy="0 0 0" />
      <mass value="0.0275" />
      <inertia
        ixx="6.00378787878787E-06"
        ixy="-6.74917024396029E-19"
        ixz="6.38681882100203E-16"
        iyy="1.30052083333333E-05"
        iyz="-1.82658583983808E-16"
        izz="1.85506628787879E-05" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://Assem1/meshes/link7.STL" />
      </geometry>
      <material name="gripper_orange">
        <color rgba="0.95 0.45 0.10 1" />
      </material>
    </visual>
  </link>

  <joint name="link6_to_link7_joint" type="prismatic">
    <origin xyz="0 0 0.0874999999816384" rpy="-1.5707963267949 0 0" />
    <parent link="link6" />
    <child link="link7" />
    <axis xyz="0 0 1" />
    <limit lower="-0.025" upper="0" effort="50" velocity="0.5" />
  </joint>

  <link name="link8">
    <inertial>
      <origin xyz="-2.07123207474069E-12 -0.022272727270361 -0.0399999999979758" rpy="0 0 0" />
      <mass value="0.0275" />
      <inertia
        ixx="6.00378787878786E-06"
        ixy="-6.6550898325543E-19"
        ixz="6.38680841981585E-16"
        iyy="1.30052083333333E-05"
        iyz="-1.82659065229028E-16"
        izz="1.85506628787879E-05" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://Assem1/meshes/link8.STL" />
      </geometry>
      <material name="gripper_orange">
        <color rgba="0.95 0.45 0.10 1" />
      </material>
    </visual>
  </link>

  <joint name="link6_to_link8_joint" type="prismatic">
    <origin xyz="0 0 0.0874999999816384" rpy="-1.5707963267949 0 0" />
    <parent link="link6" />
    <child link="link8" />
    <axis xyz="0 0 1" />
    <limit lower="0" upper="0.025" effort="50" velocity="0.5" />
  </joint>

  <!-- Gazebo Visual Colors -->
  <gazebo reference="base_link">
    <visual><material><ambient>0.18 0.20 0.24 1</ambient><diffuse>0.18 0.20 0.24 1</diffuse></material></visual>
  </gazebo>
  <gazebo reference="link1">
    <visual><material><ambient>0.05 0.35 0.78 1</ambient><diffuse>0.05 0.35 0.78 1</diffuse></material></visual>
  </gazebo>
  <gazebo reference="link2">
    <visual><material><ambient>0.05 0.35 0.78 1</ambient><diffuse>0.05 0.35 0.78 1</diffuse></material></visual>
  </gazebo>
  <gazebo reference="link3">
    <visual><material><ambient>0.88 0.90 0.92 1</ambient><diffuse>0.88 0.90 0.92 1</diffuse></material></visual>
  </gazebo>
  <gazebo reference="link4">
    <visual><material><ambient>0.05 0.35 0.78 1</ambient><diffuse>0.05 0.35 0.78 1</diffuse></material></visual>
  </gazebo>
  <gazebo reference="llink5">
    <visual><material><ambient>0.88 0.90 0.92 1</ambient><diffuse>0.88 0.90 0.92 1</diffuse></material></visual>
  </gazebo>
  <gazebo reference="link6">
    <visual><material><ambient>0.22 0.24 0.28 1</ambient><diffuse>0.22 0.24 0.28 1</diffuse></material></visual>
  </gazebo>
  <gazebo reference="link7">
    <visual><material><ambient>0.95 0.45 0.10 1</ambient><diffuse>0.95 0.45 0.10 1</diffuse></material></visual>
  </gazebo>
  <gazebo reference="link8">
    <visual><material><ambient>0.95 0.45 0.10 1</ambient><diffuse>0.95 0.45 0.10 1</diffuse></material></visual>
  </gazebo>

  <!-- Gazebo Harmonic System Plugins -->
  <gazebo>
    <plugin filename="gz-sim-joint-state-publisher-system" name="gz::sim::systems::JointStatePublisher">
      <topic>/joint_states</topic>
    </plugin>

    <plugin filename="gz-sim-joint-position-controller-system" name="gz::sim::systems::JointPositionController">
      <joint_name>link0_to_link1_joint</joint_name>
      <use_velocity_commands>true</use_velocity_commands>
      <p_gain>18.0</p_gain>
      <cmd_max>6.5</cmd_max>
      <topic>/gp7/joint1/cmd_pos</topic>
    </plugin>

    <plugin filename="gz-sim-joint-position-controller-system" name="gz::sim::systems::JointPositionController">
      <joint_name>link1_to_link2_joint</joint_name>
      <use_velocity_commands>true</use_velocity_commands>
      <p_gain>18.0</p_gain>
      <cmd_max>5.5</cmd_max>
      <topic>/gp7/joint2/cmd_pos</topic>
    </plugin>

    <plugin filename="gz-sim-joint-position-controller-system" name="gz::sim::systems::JointPositionController">
      <joint_name>link2_to_link3_joint</joint_name>
      <use_velocity_commands>true</use_velocity_commands>
      <p_gain>18.0</p_gain>
      <cmd_max>7.0</cmd_max>
      <topic>/gp7/joint3/cmd_pos</topic>
    </plugin>

    <plugin filename="gz-sim-joint-position-controller-system" name="gz::sim::systems::JointPositionController">
      <joint_name>link3_to_link4_joint</joint_name>
      <use_velocity_commands>true</use_velocity_commands>
      <p_gain>18.0</p_gain>
      <cmd_max>9.5</cmd_max>
      <topic>/gp7/joint4/cmd_pos</topic>
    </plugin>

    <plugin filename="gz-sim-joint-position-controller-system" name="gz::sim::systems::JointPositionController">
      <joint_name>link4_to_llink5_joint</joint_name>
      <use_velocity_commands>true</use_velocity_commands>
      <p_gain>18.0</p_gain>
      <cmd_max>9.5</cmd_max>
      <topic>/gp7/joint5/cmd_pos</topic>
    </plugin>

    <plugin filename="gz-sim-joint-position-controller-system" name="gz::sim::systems::JointPositionController">
      <joint_name>link5_to_link6_joint</joint_name>
      <use_velocity_commands>true</use_velocity_commands>
      <p_gain>18.0</p_gain>
      <cmd_max>15.0</cmd_max>
      <topic>/gp7/joint6/cmd_pos</topic>
    </plugin>

    <plugin filename="gz-sim-joint-position-controller-system" name="gz::sim::systems::JointPositionController">
      <joint_name>link6_to_link7_joint</joint_name>
      <use_velocity_commands>true</use_velocity_commands>
      <p_gain>15.0</p_gain>
      <cmd_max>0.5</cmd_max>
      <topic>/gp7/gripper_left/cmd_pos</topic>
    </plugin>

    <plugin filename="gz-sim-joint-position-controller-system" name="gz::sim::systems::JointPositionController">
      <joint_name>link6_to_link8_joint</joint_name>
      <use_velocity_commands>true</use_velocity_commands>
      <p_gain>15.0</p_gain>
      <cmd_max>0.5</cmd_max>
      <topic>/gp7/gripper_right/cmd_pos</topic>
    </plugin>

    <plugin filename="gz-sim-detachable-joint-system" name="gz::sim::systems::DetachableJoint">
      <parent_link>link6</parent_link>
      <child_model>box_b</child_model>
      <child_link>box_b_link</child_link>
      <detach_topic>/gp7/gripper/detach</detach_topic>
      <attach_topic>/gp7/gripper/attach</attach_topic>
    </plugin>
  </gazebo>

</robot>